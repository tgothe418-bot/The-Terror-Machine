# GEMINI_API_KEY: Required for default Gemini AI API calls (Engine turns, Voice, Forge).
GEMINI_API_KEY=

# DASHSCOPE_API_KEY: Required when TTM_ENGINE_PROVIDER=qwen
DASHSCOPE_API_KEY=

# QWEN_BASE_URL: Required when TTM_ENGINE_PROVIDER=qwen (e.g. https://dashscope-intl.aliyuncs.com/compatible-mode/v1)
QWEN_BASE_URL=

# TTM_ENGINE_PROVIDER: Engine generation provider selection (gemini | qwen). Defaults to gemini if unset.
TTM_ENGINE_PROVIDER=gemini

# APP_URL: The URL where this applet is hosted.
APP_URL=
