# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# OPENAI_API_KEY: Optional. Required only when OpenAI is selected for The Voice.
# Voice requests use the OpenAI Responses API. Keep this server-side and never commit a real key.
OPENAI_API_KEY=

# VOICE_AI_PROVIDER: Optional. "openai" (default) or "gemini".
VOICE_AI_PROVIDER=openai

# OPENAI_VOICE_MODEL: Optional approved Voice model. Defaults to gpt-5.6-luna.
OPENAI_VOICE_MODEL=gpt-5.6-luna

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=
